# Variables de entorno — plantilla
# Copiar este archivo a .env y completar con valores reales
# NO subir .env al repositorio

# PostgreSQL
POSTGRES_USER=simea
POSTGRES_PASSWORD=cambiar_este_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=simea_db

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=cambiar_este_password
INFLUXDB_ORG=simea
INFLUXDB_BUCKET=mediciones
INFLUXDB_TOKEN=generar_token_aleatorio
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_PORT=8086

# MQTT (Mosquitto)
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Backend API
API_PORT=8000
JWT_SECRET=generar_secret_aleatorio_largo
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Usuario supervisor inicial (se crea al primer arranque de la API)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_este_password

# Node-RED
NODERED_PORT=1880
