    {
        "id": "2b8aa142dd721050",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Filtro promedio móvil",
        "func": "// Promedio móvil ventana=5, con buffers separados por equipo\nvar datos = msg.payload;\nvar equipoId = datos.equipo_id;\n\nif (!equipoId) {\n    node.warn(\"Mensaje sin equipo_id, se descarta: \" + JSON.stringify(datos));\n    return null;\n}\n\n// Buffers separados por equipo. context.buffers = { \"motor_cinta_1\": [...], \"bomba_...\": [...] }\ncontext.buffers = context.buffers || {};\nif (!context.buffers[equipoId]) {\n    context.buffers[equipoId] = [];\n}\n\nvar buffer = context.buffers[equipoId];\nbuffer.push({\n    potencia_kw: datos.potencia_kw,\n    corriente_a: datos.corriente_a,\n    factor_potencia: datos.factor_potencia\n});\n\nif (buffer.length > 5) buffer.shift();\n\n// Calcular promedios sobre el buffer de este equipo\nvar suma_p = 0, suma_i = 0, suma_fp = 0;\nfor (var i = 0; i < buffer.length; i++) {\n    suma_p += buffer[i].potencia_kw;\n    suma_i += buffer[i].corriente_a;\n    suma_fp += buffer[i].factor_potencia;\n}\n\nmsg.payload = {\n    equipo_id: equipoId,\n    potencia_kw: suma_p / buffer.length,\n    corriente_a: suma_i / buffer.length,\n    factor_potencia: suma_fp / buffer.length\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "context.set('buffer_p', []);\ncontext.set('buffer_i', []);\ncontext.set('buffer_fp', []);\nreturn;",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 400,
        "wires": [
            [
                "6b5e015224846df7"
            ]
        ]
