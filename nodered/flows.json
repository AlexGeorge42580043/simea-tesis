    {
        "id": "6b5e015224846df7",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Preparar datos para InfluxDB",
        "func": "var datos = msg.payload;\nif (typeof datos === \"string\") {\n    datos = JSON.parse(datos);\n}\nif (!datos.equipo_id) {\n    node.warn(\"Falta equipo_id en el mensaje: \" + JSON.stringify(datos));\n}\nmsg.payload = [\n    {\n        potencia_kw: datos.potencia_kw,\n        corriente_a: datos.corriente_a,\n        factor_potencia: datos.factor_potencia\n    },\n    {\n        equipo_id: datos.equipo_id\n    }\n];\nreturn msg;",
